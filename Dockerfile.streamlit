FROM python:3.12-slim

WORKDIR /app

COPY requirements-ui.txt .


RUN pip install --no-cache-dir -r requirements-ui.txt

COPY src/ ./src/

COPY streamlit/ ./streamlit/

COPY outputs/clean_data/clean_data.csv ./outputs/clean_data/clean_data.csv

COPY outputs/frontend_data/ ./outputs/frontend_data

EXPOSE 8501

CMD ["streamlit", "run", "streamlit/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]